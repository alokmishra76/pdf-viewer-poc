# Copy this file to ".env". All values are optional.

# Where the mock API server runs. The Vite dev server forwards /api/* here,
# which is what removes CORS errors. Change it if you moved the server's port.
API_TARGET=http://localhost:4000

# Must match API_TOKEN in the mock server's .env
VITE_API_TOKEN=demo-token

# Apryse license key. Leave empty to run WebViewer in its 7-day trial mode.
VITE_APRYSE_LICENSE_KEY=

# Maximum disk space for cached documents, in megabytes (oldest are removed first)
VITE_CACHE_LIMIT_MB=3072
